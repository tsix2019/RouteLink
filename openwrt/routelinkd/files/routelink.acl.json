{
	"routelink": {
		"description": "Grant access to RouteLink traffic, wireless and latency statistics",
		"read": {
			"ubus": {
				"routelink": [ "info", "devices", "live", "history", "summary", "events", "stations", "signal", "survey", "latency", "outages", "speedtest_status" ]
			},
			"uci": [ "routelink" ]
		},
		"write": {
			"ubus": {
				"routelink": [ "reset", "commit", "speedtest_start" ]
			},
			"uci": [ "routelink" ]
		}
	}
}
