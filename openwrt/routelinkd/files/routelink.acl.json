{
	"routelink": {
		"description": "Grant access to RouteLink traffic and wireless statistics",
		"read": {
			"ubus": {
				"routelink": [ "info", "devices", "live", "history", "summary", "events", "stations", "signal", "survey" ]
			},
			"uci": [ "routelink" ]
		},
		"write": {
			"ubus": {
				"routelink": [ "reset", "commit" ]
			},
			"uci": [ "routelink" ]
		}
	}
}
